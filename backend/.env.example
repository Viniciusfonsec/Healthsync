# Copie para .env e ajuste os valores (cp .env.example .env)

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
API_PREFIX=/api/v1

# Banco PostgreSQL 16
DATABASE_URL=postgresql://postgres:grmo9010@localhost:5432/healthsync
DB_POOL_MAX=10

# Banco SEPARADO para os testes de integração (npm run test:db). Ele é apagado a cada execução.
# O nome precisa conter "test". Crie antes: CREATE DATABASE healthsync_test;
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthsync_test

# Segurança — troque em qualquer ambiente fora da sua máquina (mínimo 16 caracteres)
JWT_SECRET=troque-esta-chave-jwt-local
CLINIC_SELECTION_EXPIRES_IN=10m
DOCUMENT_ENCRYPTION_KEY=troque-esta-chave-de-documentos
# Requisições por minuto por IP (geral). O login tem limite próprio de 20/min por e-mail.
RATE_LIMIT_MAX=600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# true quando o backend fica atrás de um proxy (nginx do docker-compose, Render, Railway)
TRUST_PROXY=false
# Cookie só por HTTPS (padrão: true em produção)
# COOKIE_SECURE=true

# Frontend autorizado (separe por vírgula se houver mais de um)
CORS_ORIGIN=http://localhost:5173

# Senha das contas de demonstração criadas pelo seed
SEED_PASSWORD=ChangeMe123!

STORAGE_DIR=./storage/documents
REMINDER_INTERVAL_MS=60000

# E-mail real (opcional). Sem SMTP_HOST, os e-mails são apenas exibidos no console.
# Para envio real: npm install nodemailer
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=HealthSync <no-reply@healthsync.local>

{
  "name": "healthsync-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "node --import tsx --import ./tests/setup.ts --test --test-concurrency=1 tests/*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "lint:typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "verify": "npm run prisma:validate && npm run lint:typecheck && npm test && npm run build",
    "format": "npx --yes prettier@3.3.3 --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tests-db/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "npx --yes prettier@3.3.3 --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tests-db/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.1",
    "zod": "^3.25.76",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.16.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "5.9.3",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0"
  }
}
